# Server Configuration
PORT=3000
NODE_ENV=production

# Database
DATABASE_PATH=./data/nixcrm.db

# JWT Secret (cambiar por un valor aleatorio seguro)
JWT_SECRET=change_this_to_a_random_secret_key_min_32_characters_long

# Admin por defecto (solo para inicialización)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@example.com
